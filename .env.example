# Google Gemini AI API Key (Required for AI generation & real-time adaptations)
# Get a free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Google Maps Platform API Key (Required for live Maps & Places search)
# Enable Places API, Maps JavaScript API, Geocoding API at: https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY=

# Supabase Backend Configuration (For database persistence of trips and places)
# Get project URL and anon key from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
